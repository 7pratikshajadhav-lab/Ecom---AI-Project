{
  "datasets": [
    {
      "name": "29391df2",
      "displayName": "fact_transaction_denorm",
      "config": {
        "version": "1.1",
        "source": "ecommerce.gold.fact_transaction_denorm",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count"
          },
          {
            "displayName": "Total Net Amount",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            },
            "synonyms": [
              "net sales",
              "net revenue"
            ],
            "name": "total_net_amount",
            "expr": "SUM(net_amount)"
          },
          {
            "name": "total_discount_amount",
            "expr": "SUM(discount_amount_inr)",
            "displayName": "Total Discount Amount"
          },
          {
            "name": "avg_discount_pct",
            "expr": "AVG(discount_pct)/ CAST(100 AS DECIMAL(10,2))",
            "displayName": "Average Discount Percentage"
          },
          {
            "name": "total_quantity_sold",
            "expr": "SUM(quantity)",
            "displayName": "Total Quantity Sold"
          },
          {
            "name": "AOV",
            "expr": "SUM(net_amount_inr) / COUNT(*)",
            "displayName": "Average Order Value",
            "format": {
              "type": "currency",
              "currencyCode": "INR",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              },
              "abbreviation": "compact"
            }
          },
          {
            "name": "Total Discount Percentage on gross amount",
            "expr": "MEASURE(total_net_amount) / (MEASURE(total_net_amount) + MEASURE(total_discount_amount))",
            "displayName": "Total Discount Percentage on gross amount"
          }
        ]
      }
    },
    {
      "name": "dim_customer",
      "displayName": "Customer Dimension",
      "config": {
        "version": "1.1",
        "source": "ecommerce.gold.gld_dim_customer",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ]
      }
    }
  ],
